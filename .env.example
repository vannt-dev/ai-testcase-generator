# Copy this file to .env and fill in your real API key
# (or enter the API key directly in the app's sidebar when running Streamlit)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional: another AI provider. Uncomment one group and set AI_PROVIDER to
# openai, gemini or compatible (the sidebar can also switch between them).
# AI_PROVIDER=anthropic

# OPENAI_API_KEY=
# OPENAI_MODEL=

# GEMINI_API_KEY=
# GEMINI_MODEL=

# A server that speaks the OpenAI format: Ollama, LM Studio, OpenRouter, ...
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=
# AI_API_KEY=
